<?xml version="1.0" encoding="UTF-8"?>
<!-- Process API: composes System API lookups into one business view. -->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!-- GET /api/v1/process/orders/{order_id}/context  ->  {order, shipment} -->
    <flow name="get-order-context">
        <http:listener config-ref="api-listener" path="/api/v1/process/orders/{order_id}/context" allowedMethods="GET">
            <http:response statusCode="200">
                <http:headers>#[{'x-correlation-id': vars.correlationId}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[{'x-correlation-id': vars.correlationId}]</http:headers>
            </http:error-response>
        </http:listener>
        <flow-ref name="apply-policies"/>
        <set-variable variableName="orderId" value="#[attributes.uriParams.order_id]"/>
        <flow-ref name="erp-order" target="order"/>
        <flow-ref name="erp-shipment" target="shipment"/>
        <set-payload value="#[output application/json --- {order: vars.order, shipment: vars.shipment}]"/>
    </flow>
</mule>
